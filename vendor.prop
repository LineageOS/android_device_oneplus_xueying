# Bluetooth
bluetooth.device.default_name=OnePlus Open

# Graphics
ro.surface_flinger.primary_display_orientation=ORIENTATION_270
ro.surface_flinger.set_idle_timer_ms=250
ro.surface_flinger.set_touch_timer_ms=300

# Secure Element
ro.oplus.normal_boot_mode=true

# USB
vendor.usb.product_string=OnePlus Open
