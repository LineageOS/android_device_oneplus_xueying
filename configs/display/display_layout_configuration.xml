<!-- vendor/etc/displayconfig/ -->
<!--
  Displays are matched by stable physical port (cover=132, inner=131) rather than
  by EDID-derived stable display ID. The inner-panel display ID varies between
  hardware batches; port-based matching keeps fold-state switching working on all
  variants. See DisplayAddress.Physical.isPortMatch().
  -->
<layouts>
  <!-- CLOSED -->
  <layout>
    <state>0</state>
    <display defaultDisplay="true" enabled="true">
      <port>132</port>
    </display>
    <display enabled="false">
      <port>131</port>
    </display>
  </layout>

  <!-- TENT -->
  <layout>
    <state>1</state>
    <display defaultDisplay="true" enabled="true">
      <port>132</port>
    </display>
    <display enabled="false">
      <port>131</port>
    </display>
  </layout>

  <!-- HALF_OPENED -->
  <layout>
    <state>2</state>
    <display defaultDisplay="true" enabled="true">
      <port>131</port>
    </display>
    <display enabled="false">
      <port>132</port>
    </display>
  </layout>

  <!-- OPEN -->
  <layout>
    <state>3</state>
    <display defaultDisplay="true" enabled="true">
      <port>131</port>
    </display>
    <display enabled="false">
      <port>132</port>
    </display>
  </layout>
</layouts>
